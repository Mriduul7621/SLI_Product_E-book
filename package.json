{
  "name": "shanta-life-ebook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "গল্পে গল্পে শিখি — শান্তা লাইফের বিমা প্রোডাক্ট | ফিল্ড ফোর্স ট্রেনিং ই-বুক",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:docx": "node scripts/generate-docx.mjs",
    "build:pdf": "python3 scripts/build_pdf.py",
    "build:book": "npm run build:docx && npm run build:pdf"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "docx": "^9.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
